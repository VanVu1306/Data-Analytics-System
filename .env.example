# Sao chép thành .env (backend tự đọc khi khởi động). Biến môi trường thật luôn được ưu tiên.

# Chọn provider cloud cho Stage 1 và fallback Stage 3: deepseek | openai
LLM_PROVIDER=deepseek

# ── DeepSeek ──
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── OpenAI GPT (dùng khi LLM_PROVIDER=openai) ──
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6

# ── Ollama (Stage 3: viz code, chạy local) ──
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT=120
# OLLAMA_MAX_TOKENS=512

# ── Database / viz ──
# NL2VIZ_DB_PATH=./demo_db/sales_demo.db
# VIZ_SAMPLE_ROWS=3
# CHART_DPI=100

# ── Frontend (đọc từ biến môi trường của tiến trình streamlit, không phải .env) ──
# NL2VIZ_API_URL=http://127.0.0.1:8000

# ── Upload dataset & truy vấn (giai đoạn 1–2) ──
# NL2VIZ_DATASET_DIR=./data/datasets
# NL2VIZ_MAX_UPLOAD_MB=50
# NL2VIZ_IMPORT_TIMEOUT=60
# NL2VIZ_MAX_ROWS_PER_TABLE=200000
# NL2VIZ_QUERY_TIMEOUT=10
# NL2VIZ_QUERY_MAX_ROWS=1000

# ── EDA (giai đoạn 4) ──
# EDA_MAX_COLUMNS=50
# EDA_TOP_K=10
# EDA_SAMPLE_ROWS=50000
# EDA_TIMEOUT=20
# EDA_CORR_MAX_COLUMNS=15
# EDA_MAX_TABLES=10

# ── Biểu đồ (giai đoạn 5) ──
# VIZ_MODE=spec            # spec = bộ vẽ xác định (mặc định); code = LLM sinh code matplotlib rồi exec (không khuyến nghị)
# CHART_MAX_CATEGORIES=30
# CHART_PIE_MAX_SLICES=8
# CHART_MAX_POINTS=2000
# CHART_SAMPLE_ROWS=20000
# CHART_HIST_BINS=30
